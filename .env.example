# Copy these values into your shell or a local .env file.
# This file is intentionally not loaded automatically and contains no secrets.
KAREN_SERVER=http://127.0.0.1:5000
KAREN_VOICE=es-ES-ElviraNeural
KAREN_WHISPER_MODEL=base
KAREN_SAMPLE_RATE=16000
KAREN_VOICE_THRESHOLD=0.15
KAREN_RMS_THRESHOLD=0.02
KAREN_REQUEST_TIMEOUT=90
