# KAREN local configuration template.
# Set these variables in PowerShell; this file is not loaded automatically.
KAREN_SERVER=http://127.0.0.1:11434
KAREN_API_KEY=
KAREN_MODEL=qwen2:0.5b
KAREN_VOICE=es-MX-DaliaNeural
KAREN_VOICE_RATE=-1%
KAREN_VOICE_PITCH=+0Hz
KAREN_MEMORY_DIR=C:\Obsidian\Data Base\Proyecto FRIDAY
KAREN_MEMORY_FILES=IDENTITY.md,SOUL.md,USER.md,FRIDAY_Blueprint.md,FRIDAY_Protocolos_Seguridad.md,MEMORY.md,MEMORY_PROTOCOL.md
KAREN_WHISPER_MODEL=base
KAREN_SAMPLE_RATE=16000
KAREN_VOICE_THRESHOLD=0.15
KAREN_RMS_THRESHOLD=0.02
KAREN_REQUEST_TIMEOUT=90
KAREN_WAKE_WORD=true
KAREN_COMMAND_SECONDS=5
KAREN_WAKE_WORD_THRESHOLD=0.5
# Optional local continuity. Set identical absolute paths in both client processes.
KAREN_CORE_DB=C:\karen\.private\conversations.sqlite3
KAREN_TASKS_DB=C:\karen\.private\karen-tasks.sqlite3
# Optional persistent personality, shared by classic and Core 2 prompts.
# Missing file uses defaults without creating personal data.
KAREN_PERSONALITY_FILE=C:\karen\.private\personality.json
# economy: CPU for every LLM task; balanced: light tasks on CPU; quality: larger context/output.
KAREN_RESOURCE_PROFILE=balanced
# Estimated headroom requested by the Ollama router, not a physical reservation.
KAREN_VRAM_RESERVE_MIB=1536
