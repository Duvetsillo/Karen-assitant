{
  "manifest_version": 3,
  "name": "Karen Music Presence",
  "version": "1.0.0",
  "description": "Metadatos y controles locales de música para Karen, con emparejamiento explícito.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:18796/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "Emparejar Karen Music Presence"},
  "content_scripts": [{
    "matches": ["https://open.spotify.com/*", "https://music.apple.com/*", "https://music.youtube.com/*", "https://www.youtube.com/*", "https://youtube.com/*"],
    "js": ["content.js"], "run_at": "document_idle", "all_frames": false
  }]
}
